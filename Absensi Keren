// =====================

function login(){

    const username =
    document.getElementById("username").value;

    const password =
    document.getElementById("password").value;

    const user =
    users.find(u =>
        u.username === username &&
        u.password === password
    );

    if(
        username === admin.username &&
        password === admin.password
    ){

        currentUser = admin;
        isAdmin = true;

        masukDashboard();

