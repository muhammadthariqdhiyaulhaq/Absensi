    ];

    const bulan = [
        "Januari","Februari","Maret",
        "April","Mei","Juni",
        "Juli","Agustus","September",
        "Oktober","November","Desember"
    ];

    document.getElementById(
        "hariBerjalan"
    ).innerText =
    hari[now.getDay()];

    document.getElementById(
        "jamBerjalan"
    ).innerText =
    String(now.getHours()).padStart(2,"0")
    + ":" +
    String(now.getMinutes()).padStart(2,"0")
    + ":" +
    String(now.getSeconds()).padStart(2,"0");

    document.getElementById(
        "tanggalBerjalan"
    ).innerText =
    now.getDate()
    + " " +
    bulan[now.getMonth()]
    + " " +
    now.getFullYear();

}

