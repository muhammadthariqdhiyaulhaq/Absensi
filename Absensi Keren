        document
        .getElementById("siswaPanel")
        .classList.add("hidden");

    }

    renderTable();
    renderRekap();

}

// =====================
// ABSEN
// =====================

function absen(status){

    if(isAdmin){

        document.getElementById(
            "absenMessage"
        ).innerHTML =
        "<span class='error'>Admin tidak bisa absen</span>";

        return;

    }

    if(!absenAktif){

        document.getElementById(
            "absenMessage"
        ).innerHTML =
        "<span class='error'>Absensi ditutup admin</span>";

        return;

    }

    const tanggalInput =
    document.getElementById(
        "tanggalAbsen"
    ).value;

    const dateObj =
    new Date(tanggalInput + "T00:00:00");

    const namaHari = [
        "Minggu","Senin","Selasa",
        "Rabu","Kamis","Jumat","Sabtu"
    ];

    const hari =
    namaHari[dateObj.getDay()];

    const sudah =
    absensi.find(a =>

        a.username === currentUser.username &&
        a.tanggal === tanggalInput

    );

    if(sudah){

        document.getElementById(
            "absenMessage"
        ).innerHTML =
        "<span class='error'>Sudah absen di tanggal ini</span>";

        return;

    }

    absensi.push({

        username:currentUser.username,
        nama:currentUser.nama,
        hari:hari,
        status:status,
        tanggal:tanggalInput,
        waktu:new Date()
        .toLocaleTimeString("id-ID")

    });

    localStorage.setItem(
        "absensi",
        JSON.stringify(absensi)
    );

    document.getElementById(
        "absenMessage"
    ).innerHTML =
    "<span class='success'>Absensi berhasil</span>";

    renderTable();
    renderRekap();

}

// =====================
// TABEL
// =====================

function renderTable(){

    const tbody =
    document.getElementById("tableAbsensi");

    tbody.innerHTML = "";

    const data =
    isAdmin
    ? absensi
    : absensi.filter(a =>
        a.username === currentUser.username
    );

    data.sort((a,b)=>
        new Date(b.tanggal) -
        new Date(a.tanggal)
    );

    data.forEach((item,index)=>{

        tbody.innerHTML += `

        <tr>

        <td>${index+1}</td>
        <td>${item.nama}</td>
        <td>${item.hari}</td>
        <td>${item.status}</td>
        <td>${item.tanggal}</td>
        <td>${item.waktu}</td>

        <td>

        ${
            isAdmin
            ?
            `<button onclick="hapus(${index})">
            Hapus
            </button>`
            :
            "-"
        }

        </td>

        </tr>

        `;

    });

}

// =====================
// HAPUS
// =====================

function hapus(index){

    absensi.splice(index,1);

    localStorage.setItem(
        "absensi",
        JSON.stringify(absensi)
    );

    renderTable();
    renderRekap();

}

// =====================
// RESET
// =====================

function resetData(){

    if(confirm("Reset semua data?")){

        absensi = [];

        localStorage.removeItem(
            "absensi"
        );

        renderTable();
        renderRekap();

    }

}

// =====================
// TOGGLE ABSEN
// =====================

function toggleAbsen(){

    absenAktif = !absenAktif;

    localStorage.setItem(
        "absenAktif",
        JSON.stringify(absenAktif)
    );

    document.getElementById(
        "statusSistem"
    ).innerText =
    absenAktif
    ? "Aktif"
    : "Ditutup";

}

// =====================
// RESET FILTER
// =====================

function resetFilter(){

    document.getElementById(
        "filterBulanAwal"
    ).value = "";

    document.getElementById(
        "filterBulanAkhir"
    ).value = "";

    document.getElementById(
        "filterHari"
    ).value = "";

    renderRekap();

}

// =====================
// REKAP FINAL FIX
// =====================

function renderRekap(){

    if(!isAdmin) return;

    const tbody =
    document.getElementById("rekapTable");

    tbody.innerHTML = "";

    const bulanAwal =
    document.getElementById(
        "filterBulanAwal"
    ).value;

    const bulanAkhir =
    document.getElementById(
        "filterBulanAkhir"
    ).value;

    const hariFilter =
    document.getElementById(
        "filterHari"
    ).value;

    users.forEach(user=>{

        let hadir = 0;
        let izin = 0;
        let sakit = 0;
        let alpa = 0;

        absensi.forEach(item=>{

            if(item.username !== user.username){
                return;
            }

            let bulanItem = "";

            try{

                const tgl =
                new Date(item.tanggal);

                if(!isNaN(tgl)){

                    bulanItem =
                    tgl.getFullYear()
                    + "-"
                    +
                    String(tgl.getMonth()+1)
                    .padStart(2,"0");

                }

            }catch(e){

                bulanItem = "";

            }

            if(
                bulanAwal &&
                bulanItem < bulanAwal
            ){
                return;
            }

            if(
                bulanAkhir &&
                bulanItem > bulanAkhir
            ){
                return;
            }

            if(
                hariFilter &&
                item.hari !== hariFilter
            ){
                return;
            }

            if(item.status === "Hadir"){
                hadir++;
            }

            else if(item.status === "Izin"){
                izin++;
            }

            else if(item.status === "Sakit"){
                sakit++;
            }

            else{
                alpa++;
            }

        });

        const total =
        hadir + izin + sakit + alpa;

        const pH =
        total > 0
        ? ((hadir/total)*100).toFixed(1)
        : "0";

        const pI =
        total > 0
        ? ((izin/total)*100).toFixed(1)
        : "0";

        const pS =
        total > 0
        ? ((sakit/total)*100).toFixed(1)
        : "0";

        const pA =
        total > 0
        ? ((alpa/total)*100).toFixed(1)
        : "0";

        tbody.innerHTML += `

        <tr>

        <td>${user.nama}</td>

        <td>${hadir}</td>
        <td>${izin}</td>
        <td>${sakit}</td>
        <td>${alpa}</td>

        <td>${pH}%</td>
        <td>${pI}%</td>
        <td>${pS}%</td>
        <td>${pA}%</td>

        </tr>

        `;

    });

}

// =====================
